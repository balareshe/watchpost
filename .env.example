# ===== 必填 =====
# 后台服务令牌（自动化工单/通知用；请用随机串，至少 24 位）
ADMIN_TOKEN=change-me-to-a-random-32-chars

# 后台可登录的管理员邮箱（逗号分隔；首次启动会自动建账号）
# 留空则：首次访问 /admin/ 自动进入「首次安装」向导（令牌见 docker compose logs status-api）
ADMIN_EMAILS=

# ===== 镜像版本（对应 GitHub Release 的 tag，如 0.1.0；留空用 latest）=====
WATCHPOST_VERSION=0.1.0

# ===== 域名与入口 =====
DOMAIN=status.example.com
PUBLIC_URL=https://status.example.com

# ===== 邮件通知（可选；留空则后台「通知」页配置）=====
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=1

# ===== 行为参数（一般不用改）=====
TZ=Asia/Shanghai
# 失败重试次数与间隔（重试全失败才升红开单）
RETRY_TIMES=3
RETRY_GAP_SEC=2
# 连续失败多少次才进入「重试 → 开单」流程（默认 1：单次失败立即重试确认）
FAIL_THRESHOLD=1
# 恢复判定：连续成功次数
RECOVER_THRESHOLD=3
# 慢响应：延迟阈值(ms) 与 连续次数
SLOW_MS=800
SLOW_STREAK=3
# 「重大」判定门槛：事故持续多少秒才算重大（低于此值显示为「一般」黄色）
CRITICAL_MIN_SEC=90
# 采集频率（秒）与 watcher 轮询（秒）
COLLECT_INTERVAL=120
INTERVAL_SEC=60